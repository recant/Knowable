{
  "name": "knowable",
  "version": "0.2.0",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "npx -y everyapp@latest dev",
    "dev:vite": "npx -y everyapp@latest app generate-config && vite dev",
    "build": "npx -y everyapp@latest app generate-config && vite build && tsc --noEmit",
    "deploy": "npx -y everyapp@latest app deploy",
    "cf-typegen": "npx -y everyapp@latest app generate-config && wrangler types -c .everyapp/wrangler.json",
    "types:check": "tsc --noEmit"
  },
  "dependencies": {
    "@every-app/sdk": "^0.2.0",
    "@tanstack/react-router": "^1.136.3",
    "@tanstack/react-start": "^1.136.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.13.18",
    "@types/node": "^22.18.13",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.2",
    "vite-tsconfig-paths": "^5.1.4",
    "wrangler": "^4.45.3"
  }
}
